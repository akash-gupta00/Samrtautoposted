PROJECT_NAME=SmartAutoPost Backend
PROJECT_VERSION=1.0.0
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/smartautopost
SECRET_KEY=replace-with-long-random-secret
REFRESH_SECRET_KEY=replace-with-second-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
GEMINI_API_KEY=
OPENAI_API_KEY=
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://127.0.0.1:8000/api/v1/social/facebook/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
REDIS_URL=redis://localhost:6379/0
